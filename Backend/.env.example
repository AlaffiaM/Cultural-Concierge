PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/appName

# Gemini AI (primary LLM for itinerary generation and tag suggestions)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary (image uploads — not yet active)
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=123456
CLOUDINARY_API_SECRET=your_secret

# Make.com webhook secret
MAKE_WEBHOOK_SECRET=https://hook.eu1.make.com/...

# Wikipedia (free — no API key needed)
# Image finder uses Wikipedia API to fetch venue photos

# Clerk Auth — secret key from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...

# Admin auth (comma-separated emails — same list as frontend)
ADMIN_EMAILS=you@example.com,other@example.com

# Bot scheduler — refresh cadence (cron, 5-char/6-field). Default: events and venues both run at 12:00 and 18:00 daily.
BOT_SCHEDULE=0 0,18 * * *
VENUE_BOT_SCHEDULE=0 0,18 * * *
# IANA timezone the cron schedules are evaluated in.
BOT_TIMEZONE=Africa/Nairobi

# Brevo (ex-Sendinblue) — transactional email for bot run summaries.
# Generate an API key at Settings > SMTP & API > API Keys (starts with xkeysib-).
# BREVO_SENDER_EMAIL must be a sender you've verified in Brevo or you can only send to test addresses.
# BREVO_LIST_ID (optional): subscriber emails are upserted into this contact list on subscribe.
# Set BOT_EMAIL_ON=true to email run summaries after each scheduled run.
BOT_EMAIL_ON=false
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=bot@yourdomain.com
BREVO_SENDER_NAME=Culture Concierge
BREVO_LIST_ID=1
